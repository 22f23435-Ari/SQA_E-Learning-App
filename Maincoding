import java.util.HashMap;
import java.util.Map;
import java.util.Scanner;

public class ELearningApp {

    // Map to store user profiles (key: username, value: profile details)
    private static final Map<String, String> userProfiles = new HashMap<>();
    private static final Map<String, Integer> userQuizScores = new HashMap<>();
    private static final Map<String, Boolean> userQuizDisplayPreference = new HashMap<>();

    public static void main(String[] args) {
        // Display the main menu
        showMainMenu();
    }

    public static void showMainMenu() {
        Scanner scanner = new Scanner(System.in);
        int choice;

        System.out.println("=======================================");
        System.out.println("       Welcome to E-Learning App       ");
        System.out.println("=======================================");
        System.out.println("1. View Courses");
        System.out.println("2. Login");
        System.out.println("3. Register");
        System.out.println("4. Take a Quiz");
        System.out.println("5. Manage Profile");
        System.out.println("6. Exit");
        System.out.println("=======================================");
        System.out.print("Please enter your choice: ");

        try {
            choice = scanner.nextInt();

            switch (choice) {
                case 1:
                    viewCourses();
                    break;
                case 2:
                    login();
                    break;
                case 3:
                    register();
                    break;
                case 4:
                    takeQuiz();
                    break;
                case 5:
                    manageProfile();
                    break;
                case 6:
                    System.out.println("Thank you for using E-Learning App. Goodbye!");
                    break;
                default:
                    System.out.println("Invalid choice! Please select a valid option.");
                    showMainMenu();
            }
        } catch (Exception e) {
            System.out.println("Invalid input! Please enter a number.");
            scanner.next(); // Clear the invalid input
            showMainMenu();
        } finally {
            scanner.close();
        }
    }

    public static void viewCourses() {
        System.out.println("\nAvailable Courses:");
        System.out.println("1. Java Programming");
        System.out.println("2. Web Development");
        System.out.println("3. Data Science");
        System.out.println("4. Return to Main Menu");

        System.out.println("\nReturning to Main Menu...\n");
        showMainMenu();
    }

    public static void login() {
        System.out.println("\nLogin Functionality is Under Construction.");
        System.out.println("Returning to Main Menu...\n");
        showMainMenu();
    }

    public static void register() {
        System.out.println("\nRegistration Functionality is Under Construction.");
        System.out.println("Returning to Main Menu...\n");
        showMainMenu();
    }

    public static void takeQuiz() {
        Scanner scanner = new Scanner(System.in);
        int score = 0;

        System.out.println("\n=======================================");
        System.out.println("              Quiz Time!               ");
        System.out.println("=======================================");

        System.out.println("Q1. What is the capital of France?");
        System.out.println("1. Madrid");
        System.out.println("2. Berlin");
        System.out.println("3. Paris");
        System.out.println("4. Rome");
        System.out.print("Enter your answer (1-4): ");
        int answer1 = scanner.nextInt();
        if (answer1 == 3) {
            score++;
        }

        System.out.println("\nQ2. What does JVM stand for?");
        System.out.println("1. Java Virtual Machine");
        System.out.println("2. Java Verification Method");
        System.out.println("3. Java Variable Module");
        System.out.println("4. None of the above");
        System.out.print("Enter your answer (1-4): ");
        int answer2 = scanner.nextInt();
        if (answer2 == 1) {
            score++;
        }

        System.out.println("\nQ3. Which keyword is used to inherit a class in Java?");
        System.out.println("1. extends");
        System.out.println("2. implements");
        System.out.println("3. inherit");
        System.out.println("4. super");
        System.out.print("Enter your answer (1-4): ");
        int answer3 = scanner.nextInt();
        if (answer3 == 1) {
            score++;
        }

        System.out.println("\n=======================================");
        System.out.println("Your Quiz Score: " + score + "/3");
        System.out.println("=======================================");

        System.out.print("Enter your username to save your score: ");
        scanner.nextLine(); // Consume newline
        String username = scanner.nextLine();

        if (userProfiles.containsKey(username)) {
            userQuizScores.put(username, score);
            System.out.print("Do you want your quiz score to be displayed on your profile? (yes/no): ");
            String displayChoice = scanner.nextLine().toLowerCase();
            userQuizDisplayPreference.put(username, displayChoice.equals("yes"));
            System.out.println("Quiz score saved successfully!");
        } else {
            System.out.println("User not found! Please create a profile first.");
        }

        showMainMenu();
    }

    public static void manageProfile() {
        Scanner scanner = new Scanner(System.in);
        int choice;

        System.out.println("\n=======================================");
        System.out.println("         User Profile Management        ");
        System.out.println("=======================================");
        System.out.println("1. Create Profile");
        System.out.println("2. View Profile");
        System.out.println("3. Edit Profile");
        System.out.println("4. Return to Main Menu");
        System.out.println("=======================================");
        System.out.print("Please enter your choice: ");

        choice = scanner.nextInt();
        scanner.nextLine(); // Consume newline

        switch (choice) {
            case 1:
                createProfile(scanner);
                break;
            case 2:
                viewProfile(scanner);
                break;
            case 3:
                editProfile(scanner);
                break;
            case 4:
                showMainMenu();
                break;
            default:
                System.out.println("Invalid choice! Returning to Profile Management.");
                manageProfile();
        }
    }

    public static void createProfile(Scanner scanner) {
        System.out.print("\nEnter your username: ");
        String username = scanner.nextLine();

        if (userProfiles.containsKey(username)) {
            System.out.println("Profile already exists! Try editing it instead.");
        } else {
            System.out.print("Enter your profile details: ");
            String details = scanner.nextLine();
            userProfiles.put(username, details);
            System.out.println("Profile created successfully!");
        }
        manageProfile();
    }

    public static void viewProfile(Scanner scanner) {
        System.out.print("\nEnter your username: ");
        String username = scanner.nextLine();

        if (userProfiles.containsKey(username)) {
            System.out.println("Profile Details: " + userProfiles.get(username));
            if (userQuizDisplayPreference.getOrDefault(username, false)) {
                System.out.println("Quiz Score: " + userQuizScores.getOrDefault(username, 0));
            } else {
                System.out.println("Quiz Score: [Hidden]");
            }
        } else {
            System.out.println("Profile not found! Try creating it first.");
        }
        manageProfile();
    }

    public static void editProfile(Scanner scanner) {
        System.out.print("\nEnter your username: ");
        String username = scanner.nextLine();

        if (userProfiles.containsKey(username)) {
            System.out.println("Current Details: " + userProfiles.get(username));
            System.out.print("Enter new profile details: ");
            String newDetails = scanner.nextLine();
            userProfiles.put(username, newDetails);
            System.out.println("Profile updated successfully!");
        } else {
            System.out.println("Profile not found! Try creating it first.");
        }
        manageProfile();
    }
}
